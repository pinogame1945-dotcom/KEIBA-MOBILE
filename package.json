{
  "name": "keiba-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "foundation:contract": "node scripts/foundation-contract.mjs",
    "expo:config:smoke": "expo config --type public --json > /dev/null",
    "android:smoke": "expo export --platform android --output-dir dist-android-smoke --clear",
    "android:prebuild:smoke": "expo prebuild --platform android --no-install --clean"
  },
  "dependencies": {
    "cheerio": "1.0.0-rc.12",
    "encoding-japanese": "^2.2.0",
    "expo": "~57.0.17",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
