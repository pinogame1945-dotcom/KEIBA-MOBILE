{
  "name": "keiba-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "foundation:contract": "node scripts/foundation-contract.mjs",
    "live-data:contract": "node scripts/live-data-contract.mjs",
    "live-ui:contract": "node scripts/live-ui-contract.mjs",
    "reschedule:contract": "node scripts/reschedule-contract.mjs",
    "smoke:reschedule": "node --experimental-strip-types scripts/reschedule-regression.ts",
    "smoke:jra:schedule-disruption": "node --experimental-strip-types scripts/jra-schedule-disruption-regression.ts",
    "smoke:jra:entry": "node --experimental-strip-types scripts/jra-entry-regression.ts",
    "smoke:jra:venue": "node --experimental-strip-types scripts/jra-venue-regression.ts",
    "smoke:jra:final-odds": "node --experimental-strip-types scripts/jra-final-odds-regression.ts",
    "smoke:jra:result-condition": "node --experimental-strip-types scripts/jra-result-condition-regression.ts",
    "smoke:netkeiba:result-condition": "node --experimental-strip-types scripts/netkeiba-result-condition-regression.ts",
    "expo:config:smoke": "expo config --type public --json > /dev/null",
    "android:smoke": "expo export --platform android --output-dir dist-android-smoke --clear",
    "android:prebuild:smoke": "expo prebuild --platform android --no-install --clean",
    "result-archive:contract": "node scripts/result-archive-contract.mjs",
    "smoke:result-archive-guard": "node --experimental-strip-types scripts/result-archive-guard-regression.ts",
    "smoke:race-archive-week": "node --experimental-strip-types scripts/race-archive-week-regression.ts"
  },
  "dependencies": {
    "cheerio": "1.0.0-rc.12",
    "encoding-japanese": "^2.2.0",
    "expo": "~57.0.17",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
